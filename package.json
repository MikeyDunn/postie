{
  "name": "postie",
  "version": "0.1.0",
  "private": true,
  "description": "Slack app that turns beloved messages into mailed postcards",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "deploy:fast": "cdk deploy --hotswap",
    "gallery": "tsx scripts/gallery.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1086.0",
    "@aws-sdk/client-kms": "^3.1086.0",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/client-sqs": "^3.1086.0",
    "@aws-sdk/client-ssm": "^3.1086.0",
    "@aws-sdk/lib-dynamodb": "^3.1086.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@slack/bolt": "^4.7.3",
    "jimp": "^1.6.1",
    "node-emoji": "^2.2.0",
    "qrcode": "^1.5.4",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "aws-cdk": "^2.1130.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
