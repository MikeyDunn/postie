{
  "name": "postie",
  "version": "0.1.0",
  "private": true,
  "description": "Slack reactions become mailed postcards",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cd infra && cdk synth",
    "deploy": "cd infra && cdk deploy",
    "deploy:fast": "cd infra && cdk deploy --hotswap",
    "gallery": "tsx scripts/gallery.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@aws-lambda-powertools/parameters": "^2.34.0",
    "@aws-sdk/client-dynamodb": "^3.1095.0",
    "@aws-sdk/client-kms": "^3.1095.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-sqs": "^3.1095.0",
    "@aws-sdk/client-ssm": "^3.1095.0",
    "@aws-sdk/lib-dynamodb": "^3.1095.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@slack/bolt": "^5.0.0",
    "electrodb": "^3.9.1",
    "jimp": "^1.6.1",
    "node-emoji": "^2.2.0",
    "qrcode": "^1.5.4",
    "satori": "^0.29.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tsconfig/node22": "^22.0.5",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "aws-cdk": "^2.1133.0",
    "aws-cdk-lib": "^2.262.1",
    "constructs": "^10.7.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MikeyDunn/postie.git"
  }
}
